---
// A Keystroke Savers tier: its name, monthly price, hours, and who it suits.
interface Props {
  tier: { name: string; hours: number; monthly: string; suits: string };
  level?: 'h2' | 'h3';
  index?: number;
}
const { tier, level = 'h3', index = 0 } = Astro.props;
const H = level;
---
<article class="card tier" data-reveal style={`--i:${index}`}>
  <H class="display-m">{tier.name}</H>
  <p class="tier-price"><span class="counter-m">{tier.monthly}</span><span class="unit">a month</span></p>
  <dl class="tier-facts">
    <div class="tier-price"><dt class="vh">Hours</dt><dd><span class="counter-s">{tier.hours}</span> <span class="unit">hours of our time each month</span></dd></div>
  </dl>
  <p class="body">{tier.suits}</p>
</article>
