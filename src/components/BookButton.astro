---
// "Book the audit". Always goes to the booking block at the foot of the
// audit page, so the control is never disabled and never a dead link.
import { BOOK_HREF } from '../lib/data';

interface Props {
  label?: string;
  secondary?: boolean;
  /** 44px instead of 56px, for use inside a section. */
  small?: boolean;
}
const { label = 'Book the audit', secondary = false, small = false } = Astro.props;
---
<a class:list={['key', { 'key-l': !small, 'key-2': secondary }]} href={BOOK_HREF}>{label}</a>
