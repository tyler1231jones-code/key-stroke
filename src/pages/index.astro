---
// The homepage: a short sales page. It says what KEYSTROKE is, shows it is
// real, and offers one next step. Each section below the hero is one idea
// with one link; the detail lives on the page it links to.
import Base from '../layouts/Base.astro';
import Counter from '../components/Counter.astro';
import KeySvg from '../components/KeySvg.astro';
import CaseCard from '../components/CaseCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TierCard from '../components/TierCard.astro';
import Avatar from '../components/Avatar.astro';
import BookButton from '../components/BookButton.astro';
import QuizButton from '../components/QuizButton.astro';
import Fig from '../components/Fig.astro';
import Pitch from '../components/Pitch.astro';
import PostCard from '../components/PostCard.astro';
import SocialGrid from '../components/SocialGrid.astro';
import { site, crew, ledger, services, products, featuredCases, homepageTotal, proofFigures, experienceLine } from '../lib/data';
import { professionalService } from '../lib/seo';
import { dateInZone } from '../lib/ledger';
import { words, withArticle } from '../lib/format';
import { posts } from '../lib/blog';
import { socialGrid } from '../lib/social';
import '../styles/home.css';
import '../styles/blog.css';

const today = dateInZone(site.timezone);
// The three newest posts and the latest social posts; each part shows only when it has something in it.
const latest = (await posts()).slice(0, 3);
const social = socialGrid(today).length > 0;
const year = today.slice(0, 4);
const home = homepageTotal(today);
const proof = proofFigures(4);
const audit = products.audit;
// The headline is set as three lines so each can arrive on its own.
const w = site.tagline.split(' ');
const lines = [w.slice(0, 3), w.slice(3, 5), w.slice(5)].map((l) => l.join(' ')).filter(Boolean);
const crewCount = words(crew.length);
---
<Base
  title={`${site.name} | ${site.location} business automation, websites, branding`}
  description={`We find the admin your team does by hand and make it run itself, then build the reports, software, website and brand. ${site.location}-based, across Australia.`}
  canvas
  page="home"
  band="none"
  schema={[professionalService('/')]}
>
  <!-- The intro, on the first visit in a session. It hands over to the hero. -->
  <Pitch />

  <!-- 1. Hero -->
  <section id="hero" class="hero on-900" data-scene="hero">
    <div class="ground ground-900"></div>
    <div class="hero-pin">
      <div class="hero-copy">
        <h1 class="display-xl hero-h">
          {lines.map((line, i) => <><span class="line" style={`--i:${i}`}><span>{line}</span></span>{' '}</>)}
        </h1>
        <p class="lede hero-lede">{site.description}</p>
        <div class="keys hero-keys">
          <span style="--i:0"><BookButton /></span>
          <span style="--i:1"><QuizButton secondary /></span>
        </div>
      </div>
      <div class="hero-track">
        <div class="hero-stage">
          <div class="hero-slot" data-slot aria-hidden="true">
            <KeySvg class="stand-in" />
          </div>
          <div class="hero-strip">
            {ledger.length > 0 ? (
              <div class="hero-counter">
                <div class="hero-ctr-row">
                  <Counter value={home.today} size="xl" id="home-counter" data-week-ago={home.weekAgo} />
                </div>
                <p class="hero-label">
                  <span class="crew-live" data-any-unit></span>keystrokes our clients have not had to type in <span class="fig" data-year>{year}</span>
                </p>
              </div>
            ) : (
              // Until there are client figures to show, the counter counts what is on the screen: the keys of
              // the hero's own keyboard, going down as the rows drop out. The 3D scene supplies the figure, so
              // the counter is not shown until the scene is running. Its place is kept, so nothing moves when it is.
              <div class="hero-counter hero-count-keys is-off">
                <div class="hero-ctr-row">
                  <Counter value={null} widest={999} size="xl" id="keys-left" />
                </div>
                <p class="hero-label">keys left for you to press</p>
              </div>
            )}
            <p class="display-m hero-voice">We don't sell transformation. We sell a smaller number than the one you've got.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The header has no bar behind it while it sits on the hero. As soon as the hero starts to pass under it (at
       the end of the scroll sequence on a desktop, at the first scroll anywhere else) it gets its bar back. -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      var pin = document.querySelector('.hero-pin');
      var bar = document.querySelector('.bar');
      if (!pin || !bar) { d.classList.remove('bar-bare'); return; }
      var bare = null;
      var asked = false;
      function sync() {
        asked = false;
        var on = pin.getBoundingClientRect().top >= bar.offsetHeight - 2;
        if (on !== bare) { bare = on; d.classList.toggle('bar-bare', on); }
      }
      function ask() { if (!asked) { asked = true; requestAnimationFrame(sync); } }
      window.addEventListener('scroll', ask, { passive: true });
      window.addEventListener('resize', ask);
      sync();
    })();
  </script>

  <!-- 2. Proof -->
  {proof.length > 0 && (
    <section id="proof" class="section-pad">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">We counted.</h2>
          <p class="body">A keystroke is one thing a person had to type or click. Each figure is what one business stopped typing after we rebuilt one job.</p>
        </header>
        <ol class="proof-list">
          {proof.map((f) => (
            <li>
              <Counter value={f.cleared} size="m" data-roll="spin" />
              <p class="unit">keystrokes a year {withArticle(f.who)} no longer types</p>
            </li>
          ))}
        </ol>
        <a class="more" href="/counting">See how we count</a>
      </div>
    </section>
  )}

  <!-- 3. What we do -->
  <section id="services" class="section-pad home-alt">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">{words(services.length)} things we do.</h2>
      </header>
      <div class="cards cards-4">
        {services.map((s, i) => <ServiceCard item={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 4. How it starts -->
  <section id="start" class="section-pad">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">It starts with a free conversation.</h2>
        <p class="body">{audit.free} {audit.lead}</p>
      </header>
      <ol class="steps">
        {audit.steps.map((step, i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <p class="display-s">{step.title}</p>
          </li>
        ))}
      </ol>
      {products.display.audit && (
        <p class="price start-price" data-reveal><span class="counter-m">{audit.price}</span><span class="unit">{audit.terms.toLowerCase()} price</span></p>
      )}
      <a class="more" href="/audit">See how the audit works</a>
    </div>
  </section>

  <!-- 5. Featured cases -->
  {featuredCases.length > 0 && (
    <section id="work" class="section-pad home-alt">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">What was built, and what it did.</h2>
        </header>
        <div class="cards cards-3">
          {featuredCases.map((c) => <CaseCard item={c} />)}
        </div>
        <a class="more" href="/cases">See all cases</a>
      </div>
    </section>
  )}

  <!-- 6. The crew -->
  {crew.length > 0 && (
    <section id="crew" class="section-pad">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">Meet the crew.</h2>
          <p class="body">{crewCount[0].toUpperCase() + crewCount.slice(1)} AI agents do the overnight work, and we check it.</p>
        </header>
        <ul class="crew-row">
          {crew.map((a, i) => (
            <li data-unit={a.unit} data-reveal style={`--i:${i}`}>
              <Avatar name={a.name} />
              <p class="display-s agent-name">{a.name}<span class="crew-live" role="img" aria-label="Running now"></span></p>
              <p class="body-s muted">{a.role}</p>
            </li>
          ))}
        </ul>
        <a class="more" href="/crew">Meet the crew</a>
      </div>
    </section>
  )}

  <!-- 7. Keystroke Savers -->
  <section id="savers" class="section-pad home-alt">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">Keystroke Savers.</h2>
        <p class="body">{products.savers.what}</p>
      </header>
      <div class="cards cards-3">
        {products.savers.tiers.map((t, i) => <TierCard tier={t} index={i} />)}
      </div>
      <a class="more" href="/savers">See plans and pricing</a>
      <p class="body-s home-products"><a href="/products">See everything we build on the products page.</a></p>
    </div>
  </section>

  <!-- 8. From the blog, and the latest social posts -->
  {(latest.length > 0 || social) && (
    <section id="blog" class="section-pad">
      <div class="wrap">
        {latest.length > 0 && (
          <>
            <header class="section-head" data-reveal>
              <h2 class="display-l">From the blog.</h2>
            </header>
            <div class="post-cards">
              {latest.map((p) => <PostCard post={p} />)}
            </div>
            <a class="more" href="/blog">Read the blog</a>
          </>
        )}
        <SocialGrid level={latest.length > 0 ? 'h3' : 'h2'} />
      </div>
    </section>
  )}

  <!-- 9. Not sure where to start? -->
  <section class="band on-900" aria-labelledby="quiz-h" data-reveal>
    <div class="wrap band-inner">
      <h2 class="display-l" id="quiz-h">Not sure where to start?</h2>
      <p class="lede">Answer nine questions and we will tell you what to fix first.</p>
      <div class="keys"><QuizButton /></div>
    </div>
  </section>

  <!-- 10. Where we are -->
  <section class="origin">
    <div class="wrap" data-reveal>
      <p class="display-m">{site.origin}</p>
      {experienceLine && <p class="body"><Fig text={experienceLine} /></p>}
    </div>
  </section>
</Base>

<script>
  import '../scripts/home.ts';
</script>
