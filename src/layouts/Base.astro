---
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-600.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import oswald600 from '@fontsource/oswald/files/oswald-latin-600-normal.woff2?url';
import plex500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import archivo400 from '@fontsource/archivo/files/archivo-latin-400-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';
import { dateInZone } from '../lib/ledger';

interface Props {
  title: string;
  description: string;
  theme?: 'dark' | 'light';
  /** Pages with 3D carry the one persistent canvas. */
  canvas?: boolean;
  current?: string;
  page: string;
}
const { title, description, theme = 'dark', canvas = false, current, page } = Astro.props;
const buildDate = dateInZone(site.timezone);
const fullTitle = title === site.name ? `${site.name}. ${site.tagline}` : `${title} / ${site.name}`;
---
<!doctype html>
<html lang="en-AU" data-theme={theme === 'light' ? 'light' : undefined} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.demo && <meta name="robots" content="noindex, nofollow" />}
    <meta name="ks-build-date" content={buildDate} />
    <meta name="theme-color" content={theme === 'light' ? '#ffffff' : '#0b0d10'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={oswald600} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivo400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={plex500} crossorigin />
    <script is:inline>
      // Decide before first paint whether motion runs, so nothing flashes.
      // If the page script never arrives, fall back to the resting state.
      (function () {
        var d = document.documentElement;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        d.classList.add(reduce ? 'still' : 'motion');
        if (!reduce) setTimeout(function () {
          if (!d.classList.contains('run')) { d.classList.remove('motion'); d.classList.add('still'); }
        }, 5000);
      })();
    </script>
  </head>
  <body>
    <a class="skip plate" href="#main">Skip to content</a>
    {canvas && <canvas id="stage" aria-hidden="true"></canvas>}
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer standIn={canvas} />
  </body>
</html>
