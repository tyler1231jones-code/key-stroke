---
// The case card. Five things and no others: who, the problem, what we did,
// the result with its units in words, and a service tag. One motion: the
// result rolls from the before figure to the after figure as the card enters.
import Counter from './Counter.astro';
import Fig from './Fig.astro';
import { service, type Case } from '../lib/data';
import { num } from '../lib/format';

interface Props {
  item: Case;
  /** Heading level: h3 under a section heading, h2 on the cases page. */
  level?: 'h2' | 'h3';
}
const { item, level = 'h3' } = Astro.props;
const H = level;
const s = service(item.service);
---
<article class="card ccard" data-service={item.service}>
  <p class="ccard-who">{item.descriptor}</p>
  <H class="display-m"><a class="card-link" href={`/cases/${item.id}`}><Fig text={item.headline} /></a></H>
  <p class="body-s"><Fig text={item.summary} /></p>
  <dl class="ccard-result">
    <div>
      <dt>Before</dt>
      <dd><span class="figure">{num(item.before.value)}</span><span class="unit">{item.before.unit}</span></dd>
    </div>
    <div>
      <dt>After</dt>
      <dd>
        <Counter value={item.after.value} widest={item.before.value} size="s" data-roll data-from={item.before.value} />
        <span class="unit">{item.after.unit}</span>
      </dd>
    </div>
  </dl>
  <p class="tag">{s.name}</p>
</article>
