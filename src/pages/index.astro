---
// The homepage: a short sales page. It says what KEYSTROKE is, shows it is
// real, and offers one next step. Each section below the hero is one idea
// with one link; the detail lives on the page it links to.
import Base from '../layouts/Base.astro';
import Counter from '../components/Counter.astro';
import KeySvg from '../components/KeySvg.astro';
import CaseCard from '../components/CaseCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TierCard from '../components/TierCard.astro';
import Avatar from '../components/Avatar.astro';
import BookButton from '../components/BookButton.astro';
import QuizButton from '../components/QuizButton.astro';
import Fig from '../components/Fig.astro';
import { site, crew, ledger, services, products, featuredCases, homepageTotal, proofFigures, experienceLine } from '../lib/data';
import { dateInZone } from '../lib/ledger';
import { num, words, withArticle } from '../lib/format';
import '../styles/home.css';

const today = dateInZone(site.timezone);
const year = today.slice(0, 4);
const home = homepageTotal(today);
const proof = proofFigures(4);
const audit = products.audit;
// The headline is set as three lines so each can arrive on its own.
const w = site.tagline.split(' ');
const lines = [w.slice(0, 3), w.slice(3, 5), w.slice(5)].map((l) => l.join(' ')).filter(Boolean);
const crewCount = words(crew.length);
---
<Base title={site.name} description={site.description} canvas page="home" band="none">
  <!-- 1. Hero -->
  <section id="hero" class="hero on-900" data-scene="hero">
    <div class="ground ground-900"></div>
    <div class="hero-pin">
      <div class="hero-copy">
        <h1 class="display-xl hero-h">
          {lines.map((line, i) => <><span class="line" style={`--i:${i}`}><span>{line}</span></span>{' '}</>)}
        </h1>
        <p class="lede hero-lede">{site.description}</p>
        <div class="keys hero-keys">
          <span style="--i:0"><QuizButton /></span>
          <span style="--i:1"><BookButton secondary /></span>
        </div>
      </div>
      <div class="hero-track">
        <div class="hero-stage">
          <div class="hero-slot" data-slot aria-hidden="true">
            <KeySvg class="stand-in" />
          </div>
          <div class="hero-strip">
            {ledger.length > 0 && (
              <div class="hero-counter">
                <div class="hero-ctr-row">
                  <Counter value={home.today} size="xl" id="home-counter" data-week-ago={home.weekAgo} />
                  <span class="delta figure struck" id="home-delta" hidden>&minus; {num(home.today - home.weekAgo)}</span>
                </div>
                <p class="hero-label">
                  <span class="crew-live" data-any-unit></span>keystrokes our clients have not had to type in <span class="fig" data-year>{year}</span>
                </p>
              </div>
            )}
            <p class="lede hero-voice">We don't sell transformation. We sell a smaller number than the one you've got.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Proof -->
  {proof.length > 0 && (
    <section id="proof" class="section-pad">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">We counted.</h2>
          <p class="body">A keystroke is one thing a person had to type or click. Each figure is what one business stopped typing after we rebuilt one job.</p>
        </header>
        <ol class="proof-list">
          {proof.map((f) => (
            <li>
              <Counter value={f.cleared} size="m" data-roll="spin" />
              <p class="unit">keystrokes a year {withArticle(f.who)} no longer types</p>
            </li>
          ))}
        </ol>
        <a class="more" href="/counting">See how we count</a>
      </div>
    </section>
  )}

  <!-- 3. What we do -->
  <section id="services" class="section-pad home-alt">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">{words(services.length)} things we do.</h2>
      </header>
      <div class="cards cards-4">
        {services.map((s, i) => <ServiceCard item={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- 4. How it starts -->
  <section id="start" class="section-pad">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">It starts with one audit.</h2>
      </header>
      <ol class="steps">
        {audit.steps.map((step, i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <p class="display-s">{step.title}</p>
          </li>
        ))}
      </ol>
      <p class="price start-price" data-reveal><span class="counter-m">{audit.price}</span><span class="unit">{audit.terms.toLowerCase()} price</span></p>
      <a class="more" href="/audit">See how the audit works</a>
    </div>
  </section>

  <!-- 5. Featured cases -->
  {featuredCases.length > 0 && (
    <section id="work" class="section-pad home-alt">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">What was built, and what it did.</h2>
        </header>
        <div class="cards cards-3">
          {featuredCases.map((c) => <CaseCard item={c} />)}
        </div>
        <a class="more" href="/cases">See all cases</a>
      </div>
    </section>
  )}

  <!-- 6. The crew -->
  {crew.length > 0 && (
    <section id="crew" class="section-pad">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">Meet the crew.</h2>
          <p class="body">{crewCount[0].toUpperCase() + crewCount.slice(1)} AI agents do the overnight work, and we check it.</p>
        </header>
        <ul class="crew-row">
          {crew.map((a, i) => (
            <li data-unit={a.unit} data-reveal style={`--i:${i}`}>
              <Avatar name={a.name} />
              <p class="display-s agent-name">{a.name}<span class="crew-live" role="img" aria-label="Running now"></span></p>
              <p class="body-s muted">{a.role}</p>
            </li>
          ))}
        </ul>
        <a class="more" href="/crew">Meet the crew</a>
      </div>
    </section>
  )}

  <!-- 7. Keystroke Savers -->
  <section id="savers" class="section-pad home-alt">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">Keystroke Savers.</h2>
        <p class="body">{products.savers.what}</p>
      </header>
      <div class="cards cards-3">
        {products.savers.tiers.map((t, i) => <TierCard tier={t} index={i} />)}
      </div>
      <a class="more" href="/savers">Compare the plans</a>
    </div>
  </section>

  <!-- 8. Not sure where to start? -->
  <section class="band on-900" aria-labelledby="quiz-h">
    <div class="wrap band-inner">
      <h2 class="display-l" id="quiz-h">Not sure where to start?</h2>
      <p class="lede">Answer nine questions and we will tell you what to fix first.</p>
      <div class="keys"><QuizButton /></div>
    </div>
  </section>

  <!-- 9. Where we are -->
  <section class="origin">
    <div class="wrap">
      <p class="display-m">{site.origin}</p>
      {experienceLine && <p class="body"><Fig text={experienceLine} /></p>}
    </div>
  </section>
</Base>

<script>
  import '../scripts/home.ts';
</script>
