---
import Base from '../layouts/Base.astro';
import '../styles/pages.css';
---
<Base title="Page not found" description="There is no page at this address." page="404">
  <section class="page-head lost">
    <div class="wrap">
      <h1 class="display-xl load-in">Nothing here to count.</h1>
      <p class="lede load-in" style="--i:1">There is no page at this address.</p>
      <p class="load-in" style="--i:1"><a class="more lost-more" href="/">Go to the homepage</a></p>
    </div>
  </section>
</Base>

<script>
  document.documentElement.classList.add('run');
</script>
