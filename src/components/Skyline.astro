---
// An interlude before the audit: stacks of forms at different distances,
// seen side-on. Depth built from flat layers, the way Firewatch builds its
// hills: each layer is one silhouette in one token colour, distance is shown
// by value alone, and the layers move at unevenly spaced speeds.
// Drawn at build time from a seeded generator, so it is the same every visit.

function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1600;
const H = 600;

// Back to front. Depth is the fraction of page scroll a layer appears to travel;
// the gaps widen toward the front, which is what real parallax does.
const layers = [
  { depth: 0.1, fill: 'var(--base-100)', stacks: 30, sheet: 5, min: 10, max: 30, base: 0.5, seed: 3 },
  { depth: 0.2, fill: 'var(--hairline)', stacks: 21, sheet: 7, min: 10, max: 30, base: 0.6, seed: 7 },
  { depth: 0.38, fill: 'var(--rule)', stacks: 13, sheet: 10, min: 8, max: 26, base: 0.72, seed: 12 },
  { depth: 0.64, fill: 'var(--ink-muted)', stacks: 8, sheet: 15, min: 6, max: 20, base: 0.86, seed: 21 },
  { depth: 1, fill: 'var(--readout)', stacks: 4, sheet: 24, min: 3, max: 9, base: 1, seed: 40 },
].map((layer) => {
  const r = rng(layer.seed);
  const slot = W / layer.stacks;
  const baseY = H * layer.base;
  let d = '';
  for (let i = -1; i <= layer.stacks; i++) {
    if (r() < 0.16) continue; // a gap on the desk
    const width = slot * (0.56 + r() * 0.28);
    const x0 = i * slot + (slot - width) / 2 + (r() - 0.5) * slot * 0.2;
    const sheets = Math.round(layer.min + r() * (layer.max - layer.min));
    for (let s = 0; s < sheets; s++) {
      // No two sheets sit square: each is offset a little, which gives the stack its ragged edge.
      const dx = (r() - 0.5) * width * 0.07;
      const y = baseY - (s + 1) * layer.sheet;
      d += `M${(x0 + dx).toFixed(1)} ${y.toFixed(1)}h${width.toFixed(1)}v${(layer.sheet + 0.6).toFixed(1)}h${(-width).toFixed(1)}z`;
    }
  }
  // The desk the stacks stand on. It runs well below the band, because a far
  // layer is seen through the band before the band has reached it.
  d += `M${-slot} ${baseY.toFixed(1)}h${W + slot * 2}v${(H - baseY + 1000).toFixed(1)}h${-(W + slot * 2)}z`;
  return { ...layer, d };
});
---
<section class="px" data-parallax aria-hidden="true">
  {layers.map((layer) => (
    <div class="px-layer" data-depth={layer.depth}>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false">
        <path d={layer.d} fill={layer.fill} />
      </svg>
    </div>
  ))}
</section>
