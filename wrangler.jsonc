// Cloudflare Workers with static assets (not Pages). There is no Worker
// script: Cloudflare serves the built site in dist/ directly.
// Deploy with `npm run deploy` after `npx wrangler login` (done by a person).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "keystroke-site",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    // Unknown addresses get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // When the bounded "ask a question" conversation is built, add
  //   "main": "src/worker.ts"
  // and "run_worker_first": ["/api/*"] under "assets", so only that route
  // reaches the Worker and everything else stays static.
}
