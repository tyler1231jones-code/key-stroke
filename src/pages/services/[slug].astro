---
// One service. It opens with the service's demonstration at full size, then
// lists what the service offers, shows two cases, answers the questions
// people ask, and ends on the free consultation. No prices.
import Base from '../../layouts/Base.astro';
import Demo from '../../components/demos/Demo.astro';
import CaseCard from '../../components/CaseCard.astro';
import BookButton from '../../components/BookButton.astro';
import Faq from '../../components/Faq.astro';
import { services, casesOf, products, serviceHref } from '../../lib/data';
import { serviceSchema } from '../../lib/seo';
import '../../styles/pages.css';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const own = casesOf(s.id).slice(0, 2);
const keystrokes = own.some((c) => /keystroke/.test(c.before.unit));
const lower = s.name.toLowerCase().replace('ai agents', 'AI agents');
---
<Base
  title={s.title}
  description={s.description}
  current="services"
  page="service"
  service={s.id}
  crumbs={[{ name: 'Services', href: '/services' }, { name: s.name, href: serviceHref(s) }]}
  faq={s.id}
  schema={[serviceSchema(s)]}
>
  <section class="shero">
    <div class="wrap shero-grid">
      <div class="shero-copy">
        <p class="tag load-in">{s.practiceName}</p>
        <h1 class="display-xl load-in">{s.name}</h1>
        <p class="lede load-in" style="--i:1">{s.what}</p>
        <div class="load-in" style="--i:2"><BookButton service={s.id} /></div>
      </div>
      <div class="shero-demo">
        <Demo kind={s.id} />
      </div>
    </div>
  </section>

  <section class="section-pad" id="offers">
    <div class="wrap">
      <header class="section-head" data-reveal>
        <h2 class="display-l">What we offer.</h2>
      </header>
      <ul class="offers">
        {s.products.map((p, i) => (
          <li class="offer-item" data-reveal="card" style={`--i:${i % 3}`}>
            <h3 class="display-s">{p.name}</h3>
            <p class="body">{p.line}</p>
          </li>
        ))}
      </ul>
      <div class="offers-end" data-reveal>
        {products.display.builds ? (
          <ul class="ranges">
            {products.builds.map((b) => (
              <li><span>{b.name}</span><span class="figure">{b.range}</span></li>
            ))}
          </ul>
        ) : (
          <p class="body">{products.quoteLine}</p>
        )}
        <BookButton service={s.id} />
      </div>
    </div>
  </section>

  {own.length > 0 && (
    <section class="section-pad home-alt" id="cases">
      <div class="wrap">
        <header class="section-head" data-reveal>
          <h2 class="display-l">Jobs like this.</h2>
          {keystrokes && <p class="body">A keystroke is one thing a person had to type or click.</p>}
        </header>
        <div class="cards cards-2">
          {own.map((c) => <CaseCard item={c} />)}
        </div>
        <a class="more" href={`/cases?service=${s.id}`}>See all {lower} cases</a>
      </div>
    </section>
  )}

  <Faq page={s.id} />
</Base>

<script>
  import '../../scripts/page.ts';
</script>
