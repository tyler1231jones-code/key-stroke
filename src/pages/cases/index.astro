---
// Every case as a card, with one row of filters by service.
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { casesMixed, services, casesOf } from '../../lib/data';
import '../../styles/pages.css';

const used = services.filter((s) => casesOf(s.slug).length > 0);
---
<Base
  title="Cases"
  description="What we built for each business, with the figure before and the figure after."
  current="cases"
  page="cases"
>
  <section class="page-head">
    <div class="wrap">
      <h1 class="display-xl load-in">Cases.</h1>
      <p class="lede load-in" style="--i:1">A keystroke is one thing a person had to type or click. We count them before we start and again after.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      {casesMixed.length > 0 ? (
        <>
          <div class="filter" id="case-filter" role="group" aria-label="Show cases by service">
            <button class="chip" type="button" aria-pressed="true" data-value="all">All</button>
            {used.map((s) => (
              <button class="chip" type="button" aria-pressed="false" data-value={s.slug}>{s.name}</button>
            ))}
          </div>
          <p class="vh" id="filter-status" role="status" aria-live="polite"></p>
          <div class="cards cards-3" id="case-list">
            {casesMixed.map((c) => <CaseCard item={c} level="h2" />)}
          </div>
        </>
      ) : (
        <p class="body">No cases are published yet.</p>
      )}
    </div>
  </section>
</Base>

<script>
  import '../../scripts/cases.ts';
</script>
