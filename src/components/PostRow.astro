---
// One post in a list: the date it was published, the title, the reason to
// read it, and what kind of post it is, who wrote it and how long it takes,
// with its cover small beside it when it has one. The whole row is the link.
// Used on /blog, under a post, and on the service pages and the homepage.
import { Image } from 'astro:assets';
import Fig from './Fig.astro';
import { categoryLabel, person, postHref, readingMinutes, type Post } from '../lib/blog';
import { dateLong } from '../lib/format';

interface Props {
  post: Post;
  /** Heading level: h2 on /blog, h3 under a section heading. */
  level?: 'h2' | 'h3';
}
const { post, level = 'h3' } = Astro.props;
const H = level;
const { title, description, date, category, author, cover } = post.data;
// The cover's alt is empty: the title beside it already names the post, so it is not read out twice.
---
<article class:list={['post-row', cover && 'has-cover']} data-category={category}>
  <p class="post-row-date figure muted"><time datetime={date}>{dateLong(date)}</time></p>
  <div class="post-row-copy">
    <H class="display-s"><a class="card-link" href={postHref(post)}><Fig text={title} /></a></H>
    <p class="body-s"><Fig text={description} /></p>
    <p class="post-row-meta body-s muted"><span class="tag">{categoryLabel(category)}</span> <span>{person(author).name}, <Fig text={`${readingMinutes(post)} min read`} /></span></p>
  </div>
  {cover && <span class="post-row-cover"><Image src={cover} alt="" widths={[240, 480, 720]} sizes="(min-width: 900px) 360px, 112px" loading="lazy" /></span>}
</article>
