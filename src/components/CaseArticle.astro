---
// A case as a unit of content: the same object every time. Narrative and
// counts on the left, artefact on the right, evidence object in the scene
// behind. Rendered in its resting state: counter on the after figure, the
// baseline struck, the tally bar struck to its share.
import Counter from './Counter.astro';
import Artefact from './Artefact.astro';
import Fig from './Fig.astro';
import { practice, unit, tallySegments, type Case } from '../lib/data';
import { num, dateShort, slug } from '../lib/format';

interface Props {
  item: Case;
  /** Heading level: h3 inside the homepage showcase. */
  level?: 'h2' | 'h3';
}
const { item, level = 'h3' } = Astro.props;
const H = level;
const p = practice(item.practice);
const u = unit(item.crewUnit);
const isFace = item.practice === 'face';
const sameUnit = item.before.unit === item.after.unit;
const segments = 20;
const struck = isFace ? 0 : tallySegments(item.before.value, item.after.value, segments);
---
<article
  class="case"
  id={`case-${item.id}`}
  data-case={item.id}
  data-practice={item.practice}
  data-type={slug(item.businessType)}
  data-object={item.object}
  data-before={item.before.value}
  data-after={item.after.value}
>
  <div class="wrap case-grid">
    <div class="case-story">
      <div class="case-top">
        <p class="eyebrow">Case <span class="fig">{item.id}</span></p>
        {item.demo && <p class="plate demo-plate">Demonstration build / Figures illustrative</p>}
      </div>
      <p class="figure case-desc">{item.descriptor}</p>
      <H class="display-l case-headline"><Fig text={item.headline} /></H>

      <div class="case-count">
        <div class="case-figure">
          <Counter value={item.after.value} widest={item.before.value} size="m" data-roll="case" />
          <span class="unit">{item.after.unit}</span>
        </div>
        <p class="plate muted case-label">{item.scope} / from {dateShort(item.goLive)}{item.demo && <><br />Demonstration figure</>}</p>
        <p class="figure case-ba">
          <span class="vh">Before: </span><span class="struck case-before">{num(item.before.value)}</span>{!sameUnit && <span class="unit">{item.before.unit}</span>}
          <span class="muted" aria-hidden="true">&rarr;</span>
          <span class="vh">After: </span><span class="case-after">{num(item.after.value)}</span>
          <span class="unit">{item.after.unit}</span>
        </p>
        {!isFace && (
          <div class="tally-bar" data-struck={struck} role="img" aria-label="Share of the typing cleared, shown as a tally">
            {Array.from({ length: segments }).map((_, i) => <span class:list={['seg', { on: i < struck }]}></span>)}
          </div>
        )}
        <dl class="case-notes body-s">
          <div><dt class="plate muted">Before</dt><dd><Fig text={item.before.note} /></dd></div>
          <div><dt class="plate muted">After</dt><dd><Fig text={item.after.note} /></dd></div>
        </dl>
      </div>

      <div class="case-copy">
        <div>
          <p class="plate muted field-label">What was wrong</p>
          <p class="body-s"><Fig text={item.wrong} /></p>
        </div>
        <div>
          <p class="plate muted field-label">What was built</p>
          <p class="body-s"><Fig text={item.built} /></p>
        </div>
      </div>

      <dl class="case-meta">
        <div><dt class="plate muted">Builds like this</dt><dd class="figure">{item.costRange}</dd></div>
        <div><dt class="plate muted">Practice</dt><dd class="plate"><a href={`/practice/${p.key}`}>{p.n} / {p.name}</a></dd></div>
        {u && (
          <div>
            <dt class="plate muted">Runs it now</dt>
            <dd class="plate">Unit {u.unit} &mdash; {u.verb} <span class="muted">/ Not a person.</span></dd>
          </div>
        )}
      </dl>
      <p class="plate muted case-foot hair-top"><span>{item.scope}</span><span>Live {dateShort(item.goLive)}</span></p>
    </div>

    <div class="case-art">
      <div class="case-slot" data-slot aria-hidden="true">
        <img class="slot-still" src={`/stills/case-${item.id}.webp`} alt="" loading="lazy" decoding="async" />
      </div>
      <Artefact caseId={item.id} />
    </div>
  </div>
</article>
