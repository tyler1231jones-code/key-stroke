---
// The crew: the AI agents, each with a name and a drawn avatar, and each
// plainly labelled as an AI agent. They are never presented as human staff.
//
// Until an agent runs for clients (a crew.json record not marked demo), the
// page is a short noindex note. Nothing links to it then: the menu, footer,
// homepage and sitemap leave Crew out.
import Base from '../layouts/Base.astro';
import CrewCard from '../components/CrewCard.astro';
import { site, crew, agentTotal } from '../lib/data';
import { dateInZone } from '../lib/ledger';
import { words } from '../lib/format';
import '../styles/pages.css';

const today = dateInZone(site.timezone);
const widest = Math.max(0, ...crew.map((a) => agentTotal(a.unit, today)));
const running = crew.length > 0;
---
{running ? (
  <Base
    title={`The crew: ${words(crew.length)} AI agents that work overnight`}
    description={`Meet the ${words(crew.length)} AI agents that do the overnight work at KEYSTROKE: what each one does, when it runs, and what it has saved clients.`}
    current="crew"
    page="crew"
    crumbs={[{ name: 'Crew', href: '/crew' }]}
  >
    <section class="page-head">
      <div class="wrap">
        <h1 class="display-xl load-in">Meet the crew.</h1>
        <p class="lede load-in" style="--i:1">Our crew is {words(crew.length)} AI agents. They do the overnight work, and we check it.</p>
        <p class="body-s muted load-in" style="--i:1">A keystroke is one thing a person had to type or click.</p>
      </div>
    </section>

    <section class="page-body">
      <div class="wrap">
        <div class="cards cards-3">
          {crew.map((a) => <CrewCard agent={a} onDate={today} widest={widest} />)}
        </div>
      </div>
    </section>
  </Base>
) : (
  <Base
    title="The crew"
    description="The KEYSTROKE crew page opens once our AI agents run for clients."
    page="crew"
    noindex
  >
    <section class="page-head">
      <div class="wrap">
        <h1 class="display-xl load-in">The crew is not running yet.</h1>
        <p class="lede load-in" style="--i:1">This page opens once our AI agents run for clients. Until then, see what we build.</p>
        <p class="load-in" style="--i:2"><a class="more" href="/services">See our services</a></p>
      </div>
    </section>
  </Base>
)}

<script>
  import '../scripts/page.ts';
</script>
