---
// Nine questions, one per screen, tappable answers only, no email gate.
// Answers are real radio and checkbox groups. The result has its own URL,
// with the answers encoded in the hash. The result is written by Claude from
// the answers (src/worker.ts), or worked out in the page if that fails.
import Base from '../layouts/Base.astro';
import Counter from '../components/Counter.astro';
import Fig from '../components/Fig.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { questions } from '../lib/quiz';
import { products } from '../lib/data';
import '../styles/pages.css';

const available = products.items.length > 0;
---
<Base
  title="90-second quiz: what should your business fix?"
  description="Nine questions, about 90 seconds, and no email needed. Find out which manual job in your business is worth fixing first."
  crumbs={[{ name: 'Quiz', href: '/quiz' }]}
  current="quiz"
  page="quiz"
  band="none"
>
  <section class="quiz">
    <div class="wrap">
      <div class="quiz-top load-in" id="quiz-top">
        <h1 class="eyebrow">Nine questions: what should your business fix first?</h1>
        <div class="plate quiz-progress" id="quiz-progress">
          <Counter value={1} widest={questions.length} size="s" id="quiz-step" data-figure="other" />
          <span>of <span>{questions.length}</span></span>
        </div>
      </div>

      <noscript>
        <p class="quiz-noscript body">The quiz runs in the browser, so it needs JavaScript. Without it, <a href="/cases">the cases</a> are the place to start.</p>
      </noscript>

      {available ? (
        <form class="load-in" style="--i:1" id="quiz-form" novalidate>
          <div class="quiz-frame" id="quiz-frame">
            {questions.map((q, i) => (
              <fieldset class="quiz-screen" data-q={q.id} data-type={q.type} data-exclusive={'exclusive' in q ? q.exclusive : undefined} hidden={i > 0}>
                <legend class="display-l quiz-q" tabindex="-1"><Fig text={q.text} /></legend>
                {'hint' in q && <p class="body-s quiz-hint">{q.hint}</p>}
                <div class="quiz-options">
                  {q.options.map((o) => (
                    <label class="quiz-option">
                      <input type={q.type === 'multi' ? 'checkbox' : 'radio'} name={q.id} value={o.id} />
                      <span><Fig text={o.label} /></span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </div>
          <div class="quiz-nav">
            <button type="button" class="key key-l" id="quiz-next" hidden>Next</button>
            <button type="button" class="body-s quiz-back" id="quiz-back" hidden>Back</button>
          </div>
        </form>
      ) : (
        <p class="body">The quiz is not open yet.</p>
      )}

      <div class="result" id="quiz-result" hidden></div>

      {/* Below the result, never in front of it. */}
      <div class="quiz-enquiry result-block" id="quiz-enquiry" data-reveal hidden>
        <h2 class="display-m">Send me this and get in touch.</h2>
        <p class="body">Your answers and this result go to us with your details, and we reply to arrange a free conversation. So far only your nine answers have been read, to write this result. Nothing about you has been sent.</p>
        <EnquiryForm kind="quiz" id="quiz-contact" submit="Send it and get in touch" />
        <p class="result-back">
          <a class="body-s" href="/cases">See the cases</a>
          <button class="body-s quiz-back" type="button" id="quiz-again">Start again</button>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/quiz.ts';
</script>
