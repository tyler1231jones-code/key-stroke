---
// Keystroke Savers, and the published price list. What Savers is in one
// sentence, its three plans with their prices and what every plan includes;
// then website care, the two website builds and the two audits, each with its
// price; then an enquiry form that carries the chosen plan. This is the only
// page on the site that shows a price.
import Base from '../layouts/Base.astro';
import TierCard from '../components/TierCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Faq from '../components/Faq.astro';
import Fig from '../components/Fig.astro';
import { products } from '../lib/data';
// Read here and nowhere else, so the list is in this page and not in the site's scripts.
import priceList from '../content/prices.json';
import { saversSchema } from '../lib/seo';
import '../styles/pages.css';

const savers = products.savers;
const prices = products.display.savers;
const { care, websites, audits } = priceList;
---
<Base
  title="Keystroke Savers: monthly plans and pricing"
  description="What KEYSTROKE costs: Keystroke Savers plans, website care, fixed-price website builds and audits, with the hours and the price of each."
  current="savers"
  page="savers"
  band="none"
  crumbs={[{ name: 'Keystroke Savers', href: '/savers' }]}
  faq="savers"
  schema={[saversSchema()]}
>
  <section class="page-head">
    <div class="wrap">
      <h1 class="display-xl load-in">Keystroke Savers.</h1>
      <p class="lede load-in" style="--i:1">{savers.what}</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      {prices && <p class="savers-label" data-reveal><span class="tag">{savers.label}</span><span class="body-s">{savers.foundationNote}</span></p>}
      <div class="cards cards-3">
        {savers.tiers.map((t, i) => <TierCard tier={t} prices={prices} level="h2" index={i} />)}
      </div>
      {!prices && <p class="body after-list" data-reveal>{products.quoteLine}</p>}
      <div class="savers-incl">
        <h2 class="display-m" data-reveal>Every plan includes</h2>
        <ul class="ticks">
          {savers.includes.map((line, i) => <li data-reveal style={`--i:${i}`}>{line}</li>)}
          <li data-reveal style={`--i:${savers.includes.length}`}>A reply within <Fig text={savers.response} /></li>
        </ul>
        <p class="body" data-reveal>{savers.scope}</p>
      </div>

      {prices && (
        <>
          <div class="price-block" id="website-care">
            <header class="section-head" data-reveal>
              <h2 class="display-l">{care.title}.</h2>
              <p class="body">{care.what}</p>
            </header>
            <div class="cards cards-3">
              {care.tiers.map((t, i) => <TierCard tier={t} prices level="h3" index={i} plan={`${care.title}: ${t.name}`} />)}
            </div>
          </div>

          <div class="price-block" id="website-builds">
            <header class="section-head" data-reveal>
              <h2 class="display-l">{websites.title}.</h2>
              <p class="body">{websites.what}</p>
            </header>
            <div class="cards cards-2">
              {websites.builds.map((b, i) => (
                <article class="card price-card" data-reveal="card" style={`--i:${i}`}>
                  <h3 class="display-m">{b.name}</h3>
                  <p class="tier-price"><span class="counter-m">{b.price}</span><span class="unit">fixed price, excluding GST</span></p>
                  <dl class="price-facts">
                    {b.facts.map((f) => (
                      <div>
                        <dt>{f.label}</dt>
                        <dd><Fig text={f.text} /></dd>
                      </div>
                    ))}
                  </dl>
                  <a class="key key-2 tier-ask" href="#enquire" data-plan={`${websites.title}: ${b.name}`}>Ask about this build</a>
                </article>
              ))}
            </div>
            <div class="price-notes">
              {websites.after.map((line) => <p class="body" data-reveal>{line}</p>)}
            </div>
          </div>

          <div class="price-block" id="audits">
            <header class="section-head" data-reveal>
              <h2 class="display-l">{audits.title}.</h2>
              <p class="body">{audits.what}</p>
            </header>
            <div class="cards cards-2">
              {audits.items.map((a, i) => (
                <article class="card price-card" data-reveal="card" style={`--i:${i}`}>
                  <h3 class="display-m">{a.name}</h3>
                  <p class="tier-price"><span class="counter-m">{a.price}</span>{a.price !== 'Free' && <span class="unit">fixed price, excluding GST</span>}</p>
                  <p class="body"><Fig text={a.includes} /></p>
                </article>
              ))}
            </div>
            <div class="price-notes">
              <p class="body" data-reveal>{priceList.rest}</p>
              <p class="body-s muted" data-reveal>{priceList.currency}</p>
            </div>
          </div>
        </>
      )}
    </div>
  </section>

  <Faq page="savers" />

  <section class="band on-900" id="enquire" aria-labelledby="enquire-h">
    <div class="wrap band-form">
      <header class="section-head" data-reveal>
        <h2 class="display-l" id="enquire-h">Ask about a plan.</h2>
        <p class="lede" data-plan-note>Tell us what we built for you, or what you want built, and which plan you are considering.</p>
      </header>
      <EnquiryForm kind="savers" id="savers-form" submit="Send the enquiry" />
    </div>
  </section>
</Base>

<script>
  import '../scripts/page.ts';
</script>
