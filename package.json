{
  "name": "keystroke-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "node tools/check.mjs",
    "check:types": "astro check",
    "shots": "node tools/shots.mjs",
    "stills": "node tools/stills.mjs",
    "ledger": "node tools/verify-ledger.mjs",
    "deploy": "astro build && node tools/check.mjs && wrangler deploy",
    "astro": "astro",
    "qa": "node tools/qa.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "parse5": "^8.0.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite-plugin-glsl": "^1.6.1",
    "wrangler": "^4.146.0"
  },
  "private": true,
  "description": "The KEYSTROKE website: a scroll-driven site with real-time 3D, built with Astro, three.js and GSAP, deployed to Cloudflare Workers."
}
