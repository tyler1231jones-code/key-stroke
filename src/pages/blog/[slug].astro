---
// One post: its kind, title, reason to read it, and who wrote it, when and
// how long it takes; its cover, if it has one; then the post in the left two
// thirds, with the author and the post's contents in a column on the right
// (below the post on a phone). Under the post: a line to book, the service
// it is about, and two posts to read next. The closing band follows, as on
// every page.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Fig from '../../components/Fig.astro';
import PostCard from '../../components/PostCard.astro';
import PersonPhoto from '../../components/PersonPhoto.astro';
import {
  posts, person, personHref, postHtml, postSchema, relatedTo, readingMinutes, serviceOf, categoryLabel, shareOf, contentsOf, type Post,
} from '../../lib/blog';
import { abs } from '../../lib/seo';
import { products, serviceHref } from '../../lib/data';
import { dateLong } from '../../lib/format';
import '../../styles/pages.css';
import '../../styles/blog.css';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { title, description, date, updated, category, cta, draft, cover, coverAlt } = post.data;
const author = person(post.data.author);
const share = await shareOf(post);
const s = serviceOf(post);
const next = relatedTo(post, await posts());
const contents = contentsOf(post);
const ask =
  cta === 'audit'
    ? { line: `We can count this in your business. ${products.audit.free}`, href: '/audit', label: `How the ${products.audit.name.replace(/^The /, '')} works` }
    : { line: `If this is the admin in your business, talk to us. ${products.audit.free}`, href: '/contact', label: 'Book a free consultation' };
---
<Base
  title={title}
  description={description}
  page="post"
  current="blog"
  service={s?.id}
  noindex={draft}
  crumbs={[{ name: 'Blog', href: '/blog' }, { name: title, href: `/blog/${post.id}` }]}
  schema={[postSchema(post, share.src)]}
  shareImage={cover ? share : undefined}
  article={{ published: date, modified: updated ?? date, author: abs(personHref(author)), section: categoryLabel(category) }}
>
  <article class="post">
    <header class="page-head post-head">
      <div class="wrap">
        {draft && <p class="plate post-draft">Draft. Not published.</p>}
        <p class="load-in"><a class="tag" href={`/blog?kind=${category}`}>{categoryLabel(category)}</a></p>
        <h1 class="display-l load-in" style="--i:1"><Fig text={title} /></h1>
        <p class="lede load-in" style="--i:2"><Fig text={description} /></p>
        <p class="body-s muted post-byline load-in" style="--i:3">
          By <a href={personHref(author)}>{author.name}</a>, <time datetime={date}><Fig text={dateLong(date)} /></time>{updated && <>, updated <time datetime={updated}><Fig text={dateLong(updated)} /></time></>}, <Fig text={`${readingMinutes(post)} min read`} />
        </p>
      </div>
    </header>

    {cover && (
      <figure class="wrap post-cover">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1920, 2560].filter((w) => w <= cover.width)}
          sizes="(min-width: 1440px) 1450px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="wrap post-layout">
      <div class="post-main">
      <div class="prose" data-post-body set:html={postHtml(post)} />

      <div class="post-foot">
        <p class="body post-ask">{ask.line} <a href={ask.href}>{ask.label}</a>.</p>

        {s && (
          <section class="post-service card" aria-labelledby="post-service-h">
            <h2 class="display-s" id="post-service-h"><a class="card-link" href={serviceHref(s)}>{s.name}</a></h2>
            <p class="body-s">{s.line} {s.what}</p>
          </section>
        )}

        {next.length > 0 && (
          <section class="post-next" aria-labelledby="post-next-h">
            <h2 class="display-m" id="post-next-h">Read next</h2>
            <div class="post-cards post-cards-2">
              {next.map((p) => <PostCard post={p} />)}
            </div>
          </section>
        )}
      </div>
      </div>

      <aside class="post-side" aria-label="About this post">
        <div class="post-side-inner">
          <div class="post-author">
            <PersonPhoto person={author} size={72} />
            <div>
              <p class="post-author-name"><a href={personHref(author)}>{author.name}</a></p>
              <p class="body-s muted">{author.role}</p>
            </div>
          </div>
          <p class="body-s">{author.line}</p>
          {contents.length > 2 && (
            <nav class="post-contents" aria-labelledby="post-contents-h">
              <p class="body-s muted" id="post-contents-h">On this page</p>
              <ol>
                {contents.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
              </ol>
            </nav>
          )}
        </div>
      </aside>
    </div>
  </article>
</Base>

<script>
  import '../../scripts/page.ts';
</script>
