---
// The sample audit report: three labelled parts and the quote. A document,
// so it takes the light theme. Filled from shiftReport.json. Every figure is
// labelled in words. The quote range is shown only while products.display.builds is on.
import { shiftReport as r, products } from '../lib/data';
import { num } from '../lib/format';
---
{r && (
  <div class="report" data-theme="light" id="shift-report">
    <header class="report-head">
      <p class="display-s">Sample audit report</p>
      <p class="body-s muted">{r.client}. {r.process}.</p>
    </header>
    <div class="report-part">
      <p class="display-s"><span class="fig">1</span> The count</p>
      <p class="report-fig"><span class="counter-m">{num(r.count.value)}</span><span class="unit">{r.count.unit}, typed by hand</span></p>
    </div>
    <div class="report-part">
      <p class="display-s"><span class="fig">2</span> What it costs you</p>
      <p class="report-fig"><span class="counter-m">{num(r.hours.value)}</span><span class="unit">{r.hours.unit} of someone's time</span></p>
    </div>
    <div class="report-part">
      <p class="display-s"><span class="fig">3</span> What to fix first</p>
      <ol class="report-fixes">
        {r.fixes.map((f) => (
          <li>
            <span class="figure">{f.rank}</span>
            <span class="body-s">{f.what}</span>
            <span class="unit"><span class="fig">{num(f.count)}</span> keystrokes a year</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="report-part">
      <p class="display-s">The quote</p>
      {products.display.builds ? (
        <p class="report-fig"><span class="counter-m">{r.quote.range}</span><span class="unit">to rebuild this process</span></p>
      ) : (
        <p class="body">Quoted after the audit</p>
      )}
    </div>
  </div>
)}
