---
// One crew agent: avatar, name, the tag "AI agent", what the agent does, when
// the agent works, and the running total with its label in words. The tag is
// not optional: the crew must never read as human staff, and `npm run check`
// fails a crew card without it. The live mark is added on load, only while
// the agent is actually running, and never while its data is demo.
import Avatar from './Avatar.astro';
import Counter from './Counter.astro';
import { agentTotal, ledger, type CrewAgent } from '../lib/data';
import { clock } from '../lib/format';

interface Props {
  agent: CrewAgent;
  onDate: string;
  widest: number;
}
const { agent: a, onDate, widest } = Astro.props;
const total = agentTotal(a.unit, onDate);
const counted = ledger.some((row) => row.crewUnit === a.unit);
const year = onDate.slice(0, 4);
---
<article class="card agent crew-card" data-unit={a.unit} data-reveal>
  <Avatar name={a.name} />
  <div class="agent-name">
    <h2 class="display-m">{a.name}</h2>
    <span class="tag">AI agent</span>
    <span class="crew-live" role="img" aria-label="Running now"></span>
  </div>
  <p class="lede">{a.role}.</p>
  <p class="body-s">{a.character}</p>
  <dl class="agent-facts">
    <div>
      <dt class="unit">Works</dt>
      <dd class="body-s">{a.days}, <span class="fig">{clock(a.start)}</span> to <span class="fig">{clock(a.end)}</span> {a.zone}</dd>
    </div>
    {counted && (
      <div>
        <dt class="unit">Keystrokes {a.name} has saved clients in <span data-year>{year}</span></dt>
        <dd class="agent-total"><Counter value={total} widest={widest} size="s" data-unit-total={a.unit} data-roll /></dd>
      </div>
    )}
  </dl>
</article>
