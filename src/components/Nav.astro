---
import Logotype from './Logotype.astro';
import { BOOK_HREF, BOOK_LABEL } from '../lib/data';

interface Props {
  /** The key of the header item the current page belongs to. */
  current?: string;
  /** The mark alone, for a client's working page such as an onboarding form. */
  minimal?: boolean;
}
const { current, minimal = false } = Astro.props;

// Each item is its own page. The live underline marks the one the visitor is on.
const items = [
  { key: 'services', label: 'Services', href: '/services' },
  { key: 'cases', label: 'Cases', href: '/cases' },
  { key: 'audit', label: 'Audit', href: '/audit' },
  { key: 'crew', label: 'Crew', href: '/crew' },
  { key: 'savers', label: 'Savers', href: '/savers' },
  { key: 'quiz', label: 'Quiz', href: '/quiz' },
];
---
<header class="bar">
  <div class="wrap">
    <a class="bar-home" href="/" aria-label="KEYSTROKE, home">
      <Logotype variant="lockup" />
      <Logotype variant="mark" />
    </a>
    {!minimal && <nav class="bar-nav" aria-label="Site">
      <ul class="nav-list plate">
        {items.map((item) => (
          <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <a class="key bar-book" href={BOOK_HREF}>{BOOK_LABEL}</a>
      <details class="menu">
        <summary class="plate">Menu</summary>
        <ul class="menu-list">
          {items.map((item) => (
            <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </details>
    </nav>}
  </div>
</header>

<script>
  // The phone menu is a <details>, so it opens without script. This closes it
  // again when a link is followed or Escape is pressed.
  const menu = document.querySelector<HTMLDetailsElement>('details.menu');
  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    menu.addEventListener('toggle', () => document.documentElement.classList.toggle('menu-open', menu.open));
  }
</script>
