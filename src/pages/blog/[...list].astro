---
// /blog: every post, newest first, with one row of filters by kind (guides,
// news, work notes). The filters run in the page; without script every post
// shows. Separate pages per kind wait until each has six or more posts, so
// none is thin. The latest social posts follow the list.
//
// A rest route with one path, so the page is only built once there is a post
// to read (src/lib/blog.ts).
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import SocialGrid from '../../components/SocialGrid.astro';
import { posts, people, blogSchema, CATEGORIES } from '../../lib/blog';
import '../../styles/pages.css';
import '../../styles/blog.css';

export async function getStaticPaths() {
  return (await posts()).length > 0 ? [{ params: { list: undefined } }] : [];
}

const list = await posts();
const used = CATEGORIES.filter((c) => list.some((p) => p.data.category === c.id));
const names = people.map((p) => p.name.split(' ')[0]).join(' and ');
---
<Base
  title="Blog: automation, reporting, websites, branding"
  description={`Guides, news and notes from the work, written by ${names}: automation and AI agents, reporting, websites and branding, from Brisbane.`}
  page="blog"
  current="blog"
  crumbs={[{ name: 'Blog', href: '/blog' }]}
  schema={[blogSchema(list)]}
>
  <section class="page-head">
    <div class="wrap">
      <h1 class="display-xl load-in">Blog.</h1>
      <p class="lede load-in" style="--i:1">Guides, news and notes from the work, written by {names}, the two people who do it.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      {used.length > 1 && (
        <div class="filter" id="post-filter" role="group" aria-label="Show posts by kind">
          <button class="chip" type="button" aria-pressed="true" data-value="all">All</button>
          {used.map((c) => (
            <button class="chip" type="button" aria-pressed="false" data-value={c.id}>{c.label}</button>
          ))}
        </div>
      )}
      <p class="vh" id="filter-status" role="status" aria-live="polite"></p>
      <div class="post-list" id="post-list">
        {list.map((p) => <PostRow post={p} level="h2" />)}
      </div>
      <p class="body-s muted post-feed">New posts also come by <a href="/rss.xml">RSS feed</a>.</p>
      <SocialGrid />
    </div>
  </section>
</Base>

<script>
  import '../../scripts/blog.ts';
</script>
