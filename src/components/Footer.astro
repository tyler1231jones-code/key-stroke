---
// The footer: what KEYSTROKE is, where everything lives, and how to reach it.
// A contact detail that is not set yet in site.json is left out.
import Logotype from './Logotype.astro';
import { site, services, has, serviceHref, BOOK_HREF, BOOK_LABEL } from '../lib/data';

interface Props {
  /** The last line only, with privacy and terms: for a client's working page. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
const year = new Date().getFullYear();
const company = [
  { label: 'Cases', href: '/cases' },
  { label: 'Audit', href: '/audit' },
  { label: 'Crew', href: '/crew' },
  { label: 'Savers', href: '/savers' },
  { label: 'Quiz', href: '/quiz' },
  { label: 'Counting method', href: '/counting' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
];
---
<footer class:list={['foot', { 'foot-min': minimal }]}>
  <div class="wrap">
    {!minimal && <div class="foot-grid">
      <div class="foot-about" data-reveal>
        <a class="foot-logo" href="/" aria-label={`${site.name}, home`}><Logotype variant="lockup" reversed /></a>
        <p class="body-s">{site.description}</p>
      </div>
      <nav aria-label="Services" data-reveal="card" style="--i:1">
        <h2 class="plate">Services</h2>
        <ul>
          {services.map((s) => <li><a href={serviceHref(s)}>{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Company" data-reveal="card" style="--i:2">
        <h2 class="plate">Company</h2>
        <ul>
          {company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </nav>
      <div data-reveal="card" style="--i:3">
        <h2 class="plate">Contact</h2>
        <ul>
          {has('email') && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li><a href={BOOK_HREF}>{BOOK_LABEL}</a></li>
          {has('serviceArea') && <li>{site.serviceArea}</li>}
        </ul>
      </div>
    </div>}
    <div class="foot-line">
      <p>{site.origin}{has('location') && <> {site.location}.</>}</p>
      {minimal && <p><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>}
      <p>&copy; <span class="fig" data-copy-year>{year}</span> {site.name}</p>
    </div>
  </div>
</footer>

<script is:inline>
  // A page built last year still states this year.
  (function () {
    var el = document.querySelector('[data-copy-year]');
    if (el) el.textContent = String(new Date().getFullYear());
  })();
</script>
