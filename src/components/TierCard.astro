---
// A Keystroke Savers plan. A plan is named by its hours ("10 hours"). On
// /savers it carries its monthly price and a button that starts an enquiry
// about that plan. Anywhere else it shows the hours and who the plan suits,
// and no price. No tax is named beside a price: GST does not apply.
interface Props {
  tier: { name: string; hours: number; monthly: string; suits: string };
  /** Show the price. Only the Savers page does. */
  prices?: boolean;
  level?: 'h2' | 'h3';
  index?: number;
  /** What the enquiry calls the plan, where the name alone would not say. */
  plan?: string;
}
const { tier, prices = false, level = 'h3', index = 0, plan = tier.name } = Astro.props;
const H = level;
---
<article class="card tier" data-reveal="card" style={`--i:${index}`}>
  <H class="display-m">{tier.name}</H>
  <p class="plate tier-kicker">of our time, each month</p>
  {prices && (
    <>
      <p class="tier-price"><span class="counter-m">{tier.monthly}</span><span class="unit">a month</span></p>
    </>
  )}
  <p class="body">{tier.suits}</p>
  {prices && (
    <a class="key key-2 tier-ask" href="#enquire" data-plan={plan}>Ask about {tier.name}</a>
  )}
</article>
