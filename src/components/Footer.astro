---
// The footer: what KEYSTROKE is, where everything lives, and how to reach it.
// A contact detail that is not set yet in site.json is left out.
import Logotype from './Logotype.astro';
import { site, services, has, BOOK_HREF } from '../lib/data';

const year = new Date().getFullYear();
const company = [
  { label: 'Cases', href: '/cases' },
  { label: 'Audit', href: '/audit' },
  { label: 'Crew', href: '/crew' },
  { label: 'Savers', href: '/savers' },
  { label: 'Quiz', href: '/quiz' },
  { label: 'Counting method', href: '/counting' },
];
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-about">
        <a class="foot-logo" href="/" aria-label={`${site.name}, home`}><Logotype variant="lockup" reversed /></a>
        <p class="body-s">{site.description}</p>
      </div>
      <nav aria-label="Services">
        <h2 class="plate">Services</h2>
        <ul>
          {services.map((s) => <li><a href={`/services/${s.slug}`}>{s.name}</a></li>)}
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2 class="plate">Company</h2>
        <ul>
          {company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="plate">Contact</h2>
        <ul>
          {has('email') && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          <li><a href={BOOK_HREF}>Book the audit</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-line">
      <p>{site.origin}</p>
      <p>&copy; <span class="fig" data-copy-year>{year}</span> {site.name}</p>
    </div>
  </div>
</footer>

<script is:inline>
  // A page built last year still states this year.
  (function () {
    var el = document.querySelector('[data-copy-year]');
    if (el) el.textContent = String(new Date().getFullYear());
  })();
</script>
