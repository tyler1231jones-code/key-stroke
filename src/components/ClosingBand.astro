---
// How every page ends: one sentence and the two buttons. The free
// consultation is the primary action; the quiz is the way in for someone who
// is not ready to talk yet.
import BookButton from './BookButton.astro';
import QuizButton from './QuizButton.astro';

interface Props {
  /** A service id, so the form opens with that service chosen. */
  service?: string;
}
const { service } = Astro.props;
---
<section class="band on-900" aria-labelledby="close-h" data-reveal>
  <div class="wrap band-inner">
    <h2 class="display-l" id="close-h">Book a free consultation, or start with the quiz.</h2>
    <div class="keys">
      <BookButton service={service} />
      <QuizButton secondary />
    </div>
  </div>
</section>
